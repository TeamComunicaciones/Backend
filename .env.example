# .env.example
#
# Copiá este archivo a ".env" (mismo directorio, junto a manage.py) y completá
# los valores reales. ".env" está en .gitignore: nunca se sube al repositorio.
# backend/settings.py lo carga automáticamente con python-dotenv al arrancar.
#
# En producción, en vez de un archivo .env, se recomienda definir estas mismas
# variables como Environment= en los servicios systemd (gunicorn/celery/
# celerybeat) — ver README.md, sección "Despliegue en producción".

# --- Django ---
# Generar una clave nueva, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# "True" solo en desarrollo local. En producción debe ser "False" (o quedar sin definir).
DJANGO_DEBUG=True

# --- Base de datos PostgreSQL ---
# En desarrollo local podés dejarlas vacías y usar SQLite en su lugar
# (ver DATABASES en backend/settings.py si preferís ese camino).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Login con Microsoft (django-allauth) ---
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# --- Microsoft Graph / SharePoint (comprobantes de comisiones y consignaciones) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Shopify (flujo OAuth de shopify_token / shopify_return) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- SQL Server externo "Stok" (sqlControl.Sql_conexion) ---
# Usado por las vistas `informes` y `translate_products_prepago`.
STOK_DB_SERVER=
STOK_DB_USER=
STOK_DB_PASSWORD=
# Opcional, por defecto es "Stok" si no se define:
STOK_DB_NAME=

# --- Correo (Gmail SMTP) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
